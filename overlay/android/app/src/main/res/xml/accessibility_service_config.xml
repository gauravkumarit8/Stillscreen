<?xml version="1.0" encoding="utf-8"?>
<!-- v1 only listens for window changes. canRetrieveWindowContent stays false:
     Stillscreen never reads screen content. Add it later only if Reels/Shorts
     detection needs it, and update the Play permission declaration. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description" />
